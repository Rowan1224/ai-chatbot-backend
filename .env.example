# LLM Provider Selection
# Options: openai, azure, anthropic
LLM_PROVIDER=openai

# OpenAI Configuration (use if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Azure OpenAI Configuration (use if LLM_PROVIDER=azure)
# AZURE_OPENAI_API_KEY=your-azure-key-here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# OPENAI_API_VERSION=2024-12-01-preview

# Anthropic Configuration (use if LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=your-anthropic-key-here

# LangSmith Configuration (optional - for tracing)
LANGSMITH_TRACING=false
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=your-langsmith-key-here
# LANGSMITH_PROJECT=default
# Model Configuration
CHAT_MODEL=gpt-4
EMBEDDING_MODEL=text-embedding-3-small


# PostgreSQL Configuration
# Local (Docker): postgresql://chatbot:chatbot_password@localhost:5432/chatbot
# Production:     postgresql://user:password@host:5432/dbname
POSTGRESQL_URL=postgresql://chatbot:chatbot_password@localhost:5432/chatbot

# Redis Configuration
REDIS_URL=redis://localhost:6379
# For Redis with password
# REDIS_URL=redis://:password@localhost:6379

# Checkpointer Configuration
# true = Use Redis (production/test/acc - persistent sessions across restarts)
# false = Use InMemory (development - sessions lost on restart, no Redis needed)
USE_REDIS_CHECKPOINTER=true

# API Configuration
API_KEY=dev-api-key-12345
API_HOST=0.0.0.0
API_PORT=8000

# Application Settings
CONFIG_PATH=src/config/prompt_config.yaml
LOG_LEVEL=INFO

# Vector Search Provider
# Options: pgvector (native pgvector ANN), local (cosine similarity fallback)
VECTOR_SEARCH_PROVIDER=pgvector

# Duplicate Detection
DUPLICATE_DETECTION_ENABLED=true
# Enable semantic similarity search (requires embeddings, slower but catches fuzzy matches)
# Set to false to use only exact match detection (faster, no embeddings needed)
SEMANTIC_SEARCH_ENABLED=true
SIMILARITY_THRESHOLD=0.85
LOOKBACK_DAYS=90