# ─────────────────────────────────────────────────────────────────────────────
# Secrets and infrastructure configuration
# Copy to .env and fill in real values. Never commit .env to version control.
#
# Model selection, feature flags, tuning thresholds, and the system prompt
# live in src/config/app_config.yaml and src/config/prompt_config.yaml.
# ─────────────────────────────────────────────────────────────────────────────

# LLM Provider — determines which credentials below are required
# Options: openai, azure, anthropic
LLM_PROVIDER=openai

# OpenAI credentials (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Azure OpenAI credentials (required when LLM_PROVIDER=azure)
# AZURE_OPENAI_API_KEY=your-azure-key-here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# OPENAI_API_VERSION=2024-12-01-preview

# Anthropic credentials (required when LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=your-anthropic-key-here

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=your-langsmith-key-here
# LANGSMITH_PROJECT=default

# PostgreSQL — includes credentials and host, changes per environment
POSTGRESQL_URL=postgresql://chatbot:chatbot_password@localhost:5432/chatbot

# Checkpointer
# true  = Postgres (production — persistent sessions across restarts)
# false = InMemory (dev — no DB needed, sessions lost on restart)
USE_POSTGRES_CHECKPOINTER=true

# API secret key — must be set explicitly; no default in code
API_KEY=change-me-in-production

# Server bind (rarely needs changing)
# API_HOST=0.0.0.0
# API_PORT=8000

# Paths to YAML config files (change only if you move the files)
# PROMPT_CONFIG_PATH=src/config/prompt_config.yaml
# APP_CONFIG_PATH=src/config/app_config.yaml


